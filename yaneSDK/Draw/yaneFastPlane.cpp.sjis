CFastPlane::CFastPlane(CFastDraw* pFastDraw)
{
	m_pFastDraw = NULL;
	SetFastDraw(pFastDraw);

	m_nSizeX	=	0;
	m_nSizeY	=	0;
	m_lpSurface	=	NULL;
	m_lpPalette	=	NULL;

	ResetColorKey();
	m_hDC		=	NULL;

